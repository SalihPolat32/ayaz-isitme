---
import '../styles/global.css';
import { Font } from 'astro:assets';
import {
  PUBLIC_API_BASE,
  PUBLIC_GA4_ID,
  PUBLIC_GADS_ID,
  PUBLIC_GADS_APPOINTMENT_LABEL,
  PUBLIC_META_PIXEL_ID,
  PUBLIC_OPENAI_PIXEL_ID,
  PUBLIC_TURNSTILE_SITE_KEY,
  PUBLIC_SITE_ENV,
} from 'astro:env/client';
import type { Locale, SiteContent } from '../content/types';
import { business } from '../config/business';
import { localePaths, ogLocales } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import JsonLd from '../components/JsonLd.astro';
import { legalContextFromEnv } from '../content/legal/facts';
import { legalEnvFromBuild } from '../content/legal/env';

interface Props {
  locale: Locale;
  c: SiteContent;
  title?: string;
  description?: string;
  /** Yerel alternatifler (hreflang). Varsayılan: ana sayfa yolları. */
  alternates?: Record<Locale, string>;
  noindex?: boolean;
  /** Ana sayfa: LocalBusiness + FAQ JSON-LD üretilir */
  home?: boolean;
  /** false: kanonik adres, og:url ve hreflang basılmaz (404 sayfası) */
  canonical?: false;
  bodyClass?: string;
}

const { locale, c, title = c.seo.title, description = c.seo.description, alternates = localePaths, noindex = false, home = false, bodyClass = '' } = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const hasCanonical = Astro.props.canonical !== false;
const otherLocale: Locale = locale === 'tr' ? 'en' : 'tr';
const isProd = PUBLIC_SITE_ENV === 'production';
// ALLOW_INCOMPLETE_LEGAL=1 ile üretim derlemesi yalnızca QA içindir (taslak hukuki metin basabilir): site genelinde noindex.
const legalBuild = legalEnvFromBuild();
const legalCtx = legalContextFromEnv(legalBuild.env, legalBuild.reviewsMode);
const qaOverride = legalCtx.production && legalCtx.allowIncomplete;
const robots = noindex || !isProd || qaOverride ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
// Paylaşım kartı dile göre (scripts/make-og.mjs): vitrin fotoğrafı yok, doğrulanmamış iddia görünmez
const ogImage = new URL(locale === 'en' ? '/og-en.jpg' : '/og.jpg', site).href;

const runtimeConfig = {
  locale,
  apiBase: PUBLIC_API_BASE || '',
  ga4: PUBLIC_GA4_ID || '',
  gads: PUBLIC_GADS_ID || '',
  gadsLabel: PUBLIC_GADS_APPOINTMENT_LABEL || '',
  meta: PUBLIC_META_PIXEL_ID || '',
  openai: PUBLIC_OPENAI_PIXEL_ID || '',
  turnstile: PUBLIC_TURNSTILE_SITE_KEY || '',
  env: isProd ? 'production' : 'preview',
  placeId: business.google.placeId.value,
  whatsapp: business.whatsapp.number,
};
const safeJson = JSON.stringify(runtimeConfig).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={c.htmlLang} class="no-js" data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {hasCanonical && <link rel="canonical" href={canonical} />}
    {hasCanonical && Object.entries(alternates).map(([l, p]) => <link rel="alternate" hreflang={l === 'tr' ? 'tr-TR' : 'en'} href={new URL(p, site).href} />)}
    {hasCanonical && <link rel="alternate" hreflang="x-default" href={new URL(alternates.tr, site).href} />}
    <meta name="theme-color" content="#112b3c" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={locale === 'tr' ? business.brand : business.brandEn} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {hasCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.seo.ogAlt} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />

    <!-- Consent Mode v2: her şey varsayılan olarak reddedilmiş başlar. Etiketler yalnızca izinle yüklenir. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      document.documentElement.classList.remove('no-js');
    </script>
    <script type="application/json" id="ayaz-config" set:html={safeJson} />
    {home && <JsonLd locale={locale} c={c} canonical={canonical} />}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#icerik">{c.common.skip}</a>
    <Header locale={locale} c={c} onHome={home} langHref={alternates[otherLocale]} />
    <main id="icerik" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} c={c} onHome={home} langHref={alternates[otherLocale]} />
    <MobileBar c={c} />
    <ConsentBanner locale={locale} c={c} />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
