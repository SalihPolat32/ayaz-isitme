---
/** Cihaz türü için kulak silüeti + cihaz konumu (şematik). */
interface Props { type: 'bte' | 'ric' | 'ite' | 'itc' | 'cic' | 'iic'; class?: string }
const { type, class: cls = '' } = Astro.props;
---

<svg class:list={['glyph', cls]} viewBox="0 0 120 140" aria-hidden="true" focusable="false">
  <path class="glyph__ear" d="M50 18c22-8 46 4 46 30 0 20-12 26-20 40-6 10-8 24-24 26-14 2-24-8-26-20" />
  <path class="glyph__ear" d="M66 40c-6-8-20-6-22 4-2 8 4 12 8 16 6 6 4 14-2 18" />
  {type === 'bte' && (
    <>
      <path class="glyph__dev" d="M30 44c-8-12-4-30 10-32 12-2 16 10 14 22-1 8-4 12-6 18" />
      <path class="glyph__tube" d="M48 52c6-6 14-8 18-4" />
      <ellipse class="glyph__tip" cx="66" cy="50" rx="7" ry="5" />
    </>
  )}
  {type === 'ric' && (
    <>
      <path class="glyph__dev" d="M32 46c-7-10-4-26 8-28 10-1 13 9 11 19-1 6-3 9-5 14" />
      <path class="glyph__wire" d="M46 50c6-6 14-7 18-2" />
      <circle class="glyph__tip" cx="66" cy="50" r="4" />
    </>
  )}
  {type === 'ite' && <path class="glyph__dev" d="M54 38c8-6 20-2 22 8 2 12-6 22-16 24-8 1-14-4-14-12 0-8 2-15 8-20z" />}
  {type === 'itc' && <path class="glyph__dev" d="M58 44c6-3 14 0 15 8 1 8-4 14-11 14-6 0-10-4-10-10 0-5 2-9 6-12z" />}
  {type === 'cic' && <ellipse class="glyph__dev" cx="65" cy="52" rx="7" ry="8" />}
  {type === 'iic' && <ellipse class="glyph__dev glyph__dev--faint" cx="68" cy="53" rx="4.5" ry="5.5" />}
</svg>

<style>
  .glyph {
    width: 100%;
    height: auto;
    max-width: 150px;
  }
  .glyph__ear {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .glyph__dev {
    fill: var(--navy);
    stroke: none;
  }
  .glyph__dev--faint {
    fill: var(--ink-3);
    stroke: var(--navy);
    stroke-width: 1.5;
    stroke-dasharray: 3 2;
  }
  .glyph__tube,
  .glyph__wire {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .glyph__tip {
    fill: var(--accent);
    opacity: 0.85;
  }
</style>
