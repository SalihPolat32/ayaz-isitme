---
import { Image } from 'astro:assets';
import type { Locale, SiteContent } from '../content/types';
import { business } from '../config/business';
import Icon from './Icon.astro';
import poster from '../assets/device/ric-poster.png';

interface Props { locale: Locale; c: SiteContent }
const { c } = Astro.props;
---

<section class="hero" id="ana" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__blob hero__blob--a"></span>
    <span class="hero__blob hero__blob--b"></span>
  </div>
  <div class="container hero__in">
    <div class="hero__copy">
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1 id="hero-title">{c.hero.h1}</h1>
      <p class="lead">{c.hero.sub}</p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="#iletisim" data-track="appointment_start"><Icon name="calendar" />{c.hero.ctaPrimary}</a>
        <a class="btn btn--outline btn--lg" href="#incele" data-track="product_explore"><Icon name="rotate" />{c.hero.ctaSecondary}</a>
      </div>
      <ul class="hero__trust" aria-label="Hizmetler">
        {c.hero.trust.map((t) => (
          <li><Icon name="check" />{t}</li>
        ))}
      </ul>
      <a class="hero__phone" href={business.phone.href} data-track="phone_click">
        <Icon name="phone" /><span>{business.phone.display}</span>
      </a>
    </div>

    <div class="hero__stage">
      <div class="stage">
        <div class="stage__glow" aria-hidden="true"></div>
        <Image src={poster} alt={c.hero.deviceCaption} widths={[480, 640, 800, 1000]} sizes="(min-width: 900px) 480px, 86vw" priority class="stage__img" />
        <a class="stage__badge" href="#incele" data-track="product_explore">
          <Icon name="rotate" /><span>360°</span>
        </a>
        <p class="stage__caption">{c.hero.deviceCaption}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 2rem + 3vw, 5rem);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.55;
  }
  .hero__blob--a {
    width: 46vw;
    height: 46vw;
    max-width: 640px;
    max-height: 640px;
    right: -8vw;
    top: -12vw;
    background: radial-gradient(circle at 40% 40%, #cfe8ea 0%, rgba(207, 232, 234, 0) 70%);
  }
  .hero__blob--b {
    width: 30vw;
    height: 30vw;
    max-width: 420px;
    max-height: 420px;
    left: -10vw;
    bottom: -8vw;
    background: radial-gradient(circle at 50% 50%, #e4ebea 0%, rgba(228, 235, 234, 0) 70%);
  }
  .hero__in {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__in {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }
  .hero__copy {
    max-width: 40rem;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-6);
  }
  .hero__trust {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero__trust .icon {
    color: var(--accent);
    width: 1.1rem;
    height: 1.1rem;
    stroke-width: 3;
  }
  .hero__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
  }
  .hero__phone .icon {
    color: var(--accent);
  }
  .hero__stage {
    display: grid;
    justify-items: center;
    animation: stage-in var(--dur-3) var(--ease-out) both;
  }
  @keyframes stage-in {
    from {
      opacity: 0.001;
      transform: translateY(14px) scale(0.985);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__stage {
      animation: none;
    }
  }
  .stage {
    position: relative;
    width: min(100%, 560px);
    aspect-ratio: 1;
    border-radius: var(--r-xl);
    background: linear-gradient(160deg, #ffffff 0%, #eef3f2 60%, #e4ebea 100%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-3);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .stage__glow {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(8, 127, 140, 0.16) 0%, rgba(8, 127, 140, 0) 65%);
    pointer-events: none;
  }
  .stage__img {
    position: relative;
    width: 86%;
    height: auto;
  }
  .stage__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--r-pill);
    background: var(--navy);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    box-shadow: var(--shadow-2);
  }
  .stage__badge:hover {
    background: var(--navy-3);
    color: #fff;
  }
  .stage__caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    right: 1rem;
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
</style>
