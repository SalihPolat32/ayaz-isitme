---
import type { Locale, SiteContent } from '../content/types';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { locale: Locale; c: SiteContent }
const { c } = Astro.props;
const e = c.earMold;
const stepIcons = ['eye', 'hand', 'layers', 'check'] as const;
/** Kalıp render'ları (scripts/render-mold-styles.mjs): aynı ölçek, aynı tuval, beyaz zemin */
const molds = import.meta.glob<{ default: ImageMetadata }>('../assets/device/molds/*.png', { eager: true });
const mold = (name: string): ImageMetadata => {
  const m = molds[`../assets/device/molds/${name}.png`];
  if (!m) throw new Error(`Kalıp render'ı yok: ${name}.png (node scripts/render-mold-styles.mjs)`);
  return m.default;
};
/** Malzeme kutusu → render: akrilik ve silikon aynı biçim (yarım konka), dome RIC modelinden */
const materialImg = { acrylic: 'half-shell', silicone: 'half-shell-silicone', dome: 'dome' } as const;
---

<section class="section section--navy em" id="kulak-kalibi" aria-labelledby="em-title">
  <div class="container">
    <div class="em__head reveal">
      <div>
        <p class="eyebrow">{e.eyebrow}</p>
        <h2 id="em-title">{e.h2}</h2>
        <p class="lead">{e.lead}</p>
      </div>
      <div class="em__hero">
        <Image src={mold('skeleton')} alt={e.imageAlt} widths={[200, 400]} sizes="200px" loading="lazy" decoding="async" class="em__heroimg" />
      </div>
    </div>

    <ol class="em__steps reveal">
      {e.steps.map((st, i) => (
        <li>
          <span class="em__stepicon"><Icon name={stepIcons[i % stepIcons.length]} /><span class="em__num">{i + 1}</span></span>
          <h3>{st.title}</h3>
          <p>{st.text}</p>
        </li>
      ))}
    </ol>

    <div class="em__styles reveal">
      <h3 class="em__subtitle">{e.stylesTitle}</h3>
      <ul class="em__gallery" role="list">
        {e.styles.map((st) => (
          <li class="em__tile">
            <Image src={mold(st.id)} alt="" widths={[160, 320]} sizes="160px" loading="lazy" decoding="async" class="em__tileimg" />
            <h4>{st.name}</h4>
            <p>{st.text}</p>
          </li>
        ))}
      </ul>
      <p class="em__note"><Icon name="info" />{e.stylesNote}</p>
    </div>

    <div class="em__lower">
      <div class="reveal">
        <h3 class="em__subtitle">{e.materialsTitle}</h3>
        <ul class="em__materials" role="list">
          {e.materials.map((m) => (
            <li class="em__tile em__tile--mat">
              <Image src={mold(materialImg[m.id])} alt="" widths={[140, 280]} sizes="140px" loading="lazy" decoding="async" class="em__tileimg" />
              <h4>{m.name}</h4>
              <p>{m.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="em__care reveal" style="--reveal-delay:120ms">
        <h3 class="em__subtitle">{e.careTitle}</h3>
        <ul role="list">
          {e.care.map((cItem) => (
            <li><Icon name="check" />{cItem}</li>
          ))}
        </ul>
        <p class="em__dist"><Icon name="info" />{e.distinction}</p>
        <a class="btn btn--white" href="#iletisim" data-track="appointment_start" data-topic={e.eyebrow}><Icon name="calendar" />{e.cta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .em {
    background:
      radial-gradient(60% 50% at 100% 0%, rgba(8, 127, 140, 0.35) 0%, rgba(8, 127, 140, 0) 60%),
      var(--navy);
  }
  .em__head {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .em__head {
      grid-template-columns: minmax(0, 1fr) 260px;
    }
  }
  .em__head .lead {
    max-width: 60ch;
  }
  /* Kalıp render'ları beyaz zeminli: beyaz daire/kutu içinde dikişsiz durur */
  .em__hero {
    justify-self: center;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #fff;
    box-shadow: 0 0 0 10px rgba(143, 211, 218, 0.14), 0 18px 40px rgba(0, 0, 0, 0.3);
  }
  /* Görselin köşeleri daire içinde kalsın (yarı köşegen < yarıçap) */
  .em__heroimg {
    width: auto;
    height: 150px;
  }
  @media (max-width: 899px) {
    .em__hero {
      width: 170px;
      height: 170px;
    }
    .em__heroimg {
      height: 114px;
    }
  }
  .em__steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    position: relative;
  }
  @media (min-width: 720px) {
    .em__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .em__steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .em__steps li {
    padding: 1.25rem;
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .em__stepicon {
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: rgba(143, 211, 218, 0.16);
    color: #8fd3da;
    margin-bottom: 0.35rem;
  }
  /* Icon ayrı bileşen: kapsamlı stil onun <svg>'sine ulaşmaz, bu yüzden :global(.icon) */
  .em__stepicon :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .em__num {
    position: absolute;
    top: -7px;
    right: -7px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #8fd3da;
    color: var(--navy);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.75rem;
  }
  .em__steps h3 {
    font-size: 1.1rem;
  }
  .em__steps p {
    color: var(--on-navy-muted);
    font-size: var(--text-sm);
  }
  .em__lower {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  @media (min-width: 1000px) {
    .em__lower {
      grid-template-columns: 1.25fr 0.75fr;
    }
  }
  .em__subtitle {
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }
  .em__styles {
    margin-top: var(--space-7);
  }
  .em__gallery,
  .em__materials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 760px) {
    .em__gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 560px) {
    .em__materials {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* Dar ekranda 2 sütun: tek kalan son kutu (dome) satırı kaplasın */
  @media (max-width: 559px) {
    .em__materials > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .em__tile {
    display: grid;
    grid-template-rows: auto auto 1fr;
    justify-items: center;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem 1rem;
    border-radius: var(--r-lg);
    background: #fff;
    color: var(--ink);
    text-align: center;
  }
  /* Aynı ölçek: tüm biçimler aynı tuvalde → sabit yükseklik, gerçek boy farkı korunur */
  .em__tileimg {
    width: auto;
    height: 150px;
    max-width: 100%;
    object-fit: contain;
  }
  .em__tile--mat .em__tileimg {
    height: 110px;
  }
  .em__tile h4 {
    font-size: 1rem;
    margin-top: 0.35rem;
  }
  .em__tile p {
    font-size: var(--text-sm);
    color: var(--ink-2);
    line-height: 1.4;
  }
  .em__note {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.9rem;
    font-size: var(--text-sm);
    color: var(--on-navy-muted);
  }
  .em__note :global(.icon) {
    flex: none;
    margin-top: 0.15em;
  }
  .em__care {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }
  .em__care .em__subtitle {
    margin-bottom: 0;
  }
  .em__care ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }
  .em__care li {
    display: flex;
    gap: 0.6rem;
    color: var(--on-navy);
    font-size: var(--text-sm);
  }
  .em__care li :global(.icon) {
    flex: none;
    color: #8fd3da;
    stroke-width: 3;
    margin-top: 0.15em;
  }
  .em__dist {
    display: flex;
    gap: 0.6rem;
    font-size: var(--text-sm);
    color: var(--on-navy-muted);
    padding: 0.9rem 1rem;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.06);
  }
  .em__dist :global(.icon) {
    flex: none;
    margin-top: 0.15em;
  }
  .em__care .btn {
    justify-self: start;
  }
</style>
