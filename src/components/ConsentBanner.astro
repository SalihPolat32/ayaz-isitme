---
import type { Locale, SiteContent } from '../content/types';
import { legalPaths } from '../i18n';
import Icon from './Icon.astro';
interface Props { locale: Locale; c: SiteContent }
const { locale, c } = Astro.props;
---

<section class="consent" id="consent" role="region" aria-labelledby="consent-title" data-consent hidden>
  <div class="consent__card">
    <div class="consent__head">
      <Icon name="cookie" />
      <h2 id="consent-title">{c.consent.title}</h2>
    </div>
    <p class="consent__text">{c.consent.text} <a href={legalPaths[locale]}>{c.consent.policyLink}</a></p>

    <div class="consent__cats" data-consent-cats hidden>
      {c.consent.categories.map((cat) => (
        <label class="consent__cat">
          <input type="checkbox" name={cat.key} checked={cat.key === 'necessary'} disabled={cat.locked} data-consent-cat={cat.key} />
          <span class="consent__catbody">
            <span class="consent__catlabel">{cat.label}</span>
            <span class="consent__cattext">{cat.text}</span>
          </span>
        </label>
      ))}
    </div>

    <div class="consent__actions">
      <button class="btn btn--primary btn--sm" type="button" data-consent-accept>{c.consent.acceptAll}</button>
      <button class="btn btn--outline btn--sm" type="button" data-consent-reject>{c.consent.rejectAll}</button>
      <button class="btn btn--ghost btn--sm" type="button" data-consent-manage aria-expanded="false" aria-controls="consent-cats">{c.consent.manage}</button>
      <button class="btn btn--navy btn--sm" type="button" data-consent-save hidden>{c.consent.save}</button>
    </div>
  </div>
</section>

<style>
  .consent {
    position: fixed;
    z-index: var(--z-dialog);
    left: 0;
    right: 0;
    bottom: calc(60px + env(safe-area-inset-bottom));
    padding: 0 var(--space-3);
    display: flex;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .consent {
      bottom: var(--space-5);
      left: var(--space-5);
      right: auto;
      padding: 0;
      max-width: 440px;
    }
  }
  .consent__card {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-3);
    padding: 1.1rem 1.2rem;
    animation: consent-in var(--dur-3) var(--ease-out);
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .consent__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .consent__head .icon {
    color: var(--accent);
  }
  .consent__head h2 {
    font-size: 1.05rem;
  }
  .consent__text {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .consent__cats {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .consent__cat {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    cursor: pointer;
  }
  .consent__cat input {
    width: 20px;
    height: 20px;
    margin-top: 0.15rem;
    accent-color: var(--accent);
    flex: none;
  }
  .consent__catbody {
    display: grid;
    gap: 0.1rem;
  }
  .consent__catlabel {
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .consent__cattext {
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }
</style>
