---
import type { Locale, SiteContent } from '../content/types';
import Icon from './Icon.astro';
import TypeGlyph from './TypeGlyph.astro';

interface Props { locale: Locale; c: SiteContent }
const { locale, c } = Astro.props;
const d = c.devices;
const th = d.tableHeaders;
const dots = (n: number) => Array.from({ length: 5 }, (_, i) => i < n);
const compareLabel = locale === 'tr' ? 'Tüm türleri karşılaştır' : 'Compare all types';
const tableCaption = locale === 'tr' ? 'İşitme cihazı türleri karşılaştırma tablosu' : 'Hearing aid types comparison table';
---

<section class="section section--soft dt" id="cihazlar" aria-labelledby="dt-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 id="dt-title">{d.h2}</h2>
      <p class="lead">{d.lead}</p>
    </div>

    <div class="tabs reveal" data-tabs>
      <div class="tabs__list" role="tablist" aria-label={d.eyebrow}>
        {d.types.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${t.id}`}
            tabindex={i === 0 ? 0 : -1}
            class="tabs__tab"
            data-tab
          >
            <span class="tabs__code">{t.code}</span>
            <span class="tabs__name">{t.name}</span>
          </button>
        ))}
      </div>

      {d.types.map((t, i) => (
        <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class="tabs__panel" tabindex="0" hidden={i !== 0} data-panel>
          <div class="tp">
            <div class="tp__visual">
              <TypeGlyph type={t.id as 'bte'} />
              <div class="tp__vis">
                <span class="small muted">{th.visibility}</span>
                <span class="dots" role="img" aria-label={t.visibility.label}>
                  {dots(t.visibility.level).map((on) => <i class:list={['dot', { on }]}></i>)}
                </span>
                <span class="tp__vislabel">{t.visibility.label}</span>
              </div>
            </div>
            <div class="tp__body">
              <p class="pill">{t.code} · {t.short}</p>
              <h3>{t.name}</h3>
              <p class="tp__desc">{t.description}</p>
              <dl class="spec">
                <div><dt>{th.suits}</dt><dd>{t.suits}</dd></div>
                <div><dt>{th.power}</dt><dd>{t.power}</dd></div>
                <div><dt>{th.rechargeable}</dt><dd>{t.rechargeable}</dd></div>
                <div><dt>{th.wireless}</dt><dd>{t.wireless}</dd></div>
                <div><dt>{th.handling}</dt><dd>{t.handling}</dd></div>
                <div><dt>{th.care}</dt><dd>{t.care}</dd></div>
              </dl>
              {t.note && <p class="notice"><Icon name="info" />{t.note}</p>}
              <a class="btn btn--outline btn--sm mt-4" href="#iletisim" data-track="appointment_start" data-topic={t.code}><Icon name="message" />{d.askCta}</a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <details class="acc dt__compare reveal">
      <summary>{compareLabel}<span class="acc__chev"><Icon name="chevron-down" /></span></summary>
      <div class="acc__body dt__tablewrap">
        <table class="cmp">
          <caption class="sr-only">{tableCaption}</caption>
          <thead>
            <tr>
              <th scope="col"></th>
              {d.types.map((t) => <th scope="col">{t.code}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr><th scope="row">{th.visibility}</th>{d.types.map((t) => <td>{t.visibility.label}</td>)}</tr>
            <tr><th scope="row">{th.power}</th>{d.types.map((t) => <td>{t.power}</td>)}</tr>
            <tr><th scope="row">{th.rechargeable}</th>{d.types.map((t) => <td>{t.rechargeable}</td>)}</tr>
            <tr><th scope="row">{th.wireless}</th>{d.types.map((t) => <td>{t.wireless}</td>)}</tr>
            <tr><th scope="row">{th.handling}</th>{d.types.map((t) => <td>{t.handling}</td>)}</tr>
            <tr><th scope="row">{th.care}</th>{d.types.map((t) => <td>{t.care}</td>)}</tr>
          </tbody>
        </table>
      </div>
    </details>

    <div class="dt__systems reveal">
      <h3>{d.systems.title}</h3>
      <div class="grid grid--3 mt-5">
        {d.systems.items.map((s) => (
          <article class="card card--pad">
            <h4>{s.name}</h4>
            <p class="small muted mt-4">{s.text}</p>
          </article>
        ))}
      </div>
    </div>
    <p class="dt__disc small muted reveal"><Icon name="info" />{d.disclaimer}</p>
  </div>
</section>

<style>
  .tabs {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-1);
    overflow: hidden;
  }
  .tabs__list {
    display: flex;
    gap: 0.25rem;
    padding: 0.6rem;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--surface-2);
  }
  .tabs__list::-webkit-scrollbar {
    display: none;
  }
  .tabs__tab {
    flex: 1 0 auto;
    display: grid;
    gap: 0.05rem;
    text-align: left;
    padding: 0.6rem 0.9rem;
    min-height: 56px;
    border-radius: var(--r-md);
    color: var(--ink-2);
    transition: background var(--dur-1), color var(--dur-1), box-shadow var(--dur-1);
  }
  .tabs__tab:hover {
    background: rgba(255, 255, 255, 0.7);
  }
  .tabs__tab[aria-selected='true'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-1);
  }
  .tabs__code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .tabs__name {
    font-size: var(--text-xs);
  }
  .tabs__panel {
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    animation: fade-in var(--dur-2) var(--ease-out);
  }
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .tp {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 760px) {
    .tp {
      grid-template-columns: 200px minmax(0, 1fr);
    }
  }
  .tp__visual {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--r-lg);
    background: var(--surface-2);
  }
  .tp__vis {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
  }
  .dots {
    display: inline-flex;
    gap: 4px;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .dot.on {
    background: var(--accent);
  }
  .tp__vislabel {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink);
  }
  .tp__body h3 {
    margin-top: 0.75rem;
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
  }
  .tp__desc {
    margin-top: 0.75rem;
    color: var(--ink-2);
    max-width: 64ch;
  }
  .spec {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.6rem 1.5rem;
  }
  @media (min-width: 640px) {
    .spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .spec > div:first-child {
      grid-column: 1 / -1;
    }
  }
  .spec div {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--r-md);
    background: var(--surface-2);
  }
  .spec dt {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .spec dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink);
  }
  .dt__compare {
    margin-top: var(--space-6);
    border-bottom: 1px solid var(--line);
  }
  .dt__tablewrap {
    overflow-x: auto;
    max-width: none;
  }
  .cmp {
    border-collapse: collapse;
    width: 100%;
    min-width: 720px;
    font-size: var(--text-sm);
  }
  .cmp th,
  .cmp td {
    text-align: left;
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .cmp thead th {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--ink);
    background: var(--surface-2);
  }
  .cmp tbody th {
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }
  .dt__systems {
    margin-top: var(--space-7);
  }
  .dt__systems h4 {
    font-size: 1.1rem;
  }
  .dt__disc {
    display: flex;
    gap: 0.5rem;
    margin-top: var(--space-5);
    max-width: 80ch;
  }
  .dt__disc .icon {
    flex: none;
    margin-top: 0.2em;
  }
</style>
