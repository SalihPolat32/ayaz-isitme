---
import type { Locale, SiteContent } from '../content/types';
import Icon from './Icon.astro';
import EarView from './EarView.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import moldImg from '../assets/device/molds/half-shell-silicone.png';

interface Props { locale: Locale; c: SiteContent }
const { locale, c } = Astro.props;
const d = c.devices;
const th = d.tableHeaders;
const dots = (n: number) => Array.from({ length: 5 }, (_, i) => i < n);
const thumbs = import.meta.glob<{ default: ImageMetadata }>('../assets/device/views/thumb-*.png', { eager: true });
const thumbFor = (id: string): ImageMetadata | null => thumbs[`../assets/device/views/thumb-${id}.png`]?.default ?? null;
const fig = d.figure;
/** Kulak arkası türlerde gövde yarı saydam çizilir → altında açıklama */
const behindEar = (id: string) => id === 'bte' || id === 'ric';
const compareLabel = locale === 'tr' ? 'Tüm türleri karşılaştır' : 'Compare all types';
const tableCaption = locale === 'tr' ? 'İşitme cihazı türleri karşılaştırma tablosu' : 'Hearing aid types comparison table';
---

<section class="section section--soft dt" id="cihazlar" aria-labelledby="dt-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 id="dt-title">{d.h2}</h2>
      <p class="lead">{d.lead}</p>
    </div>

    <div class="tabs reveal" data-tabs>
      <div class="tabs__list" role="tablist" aria-label={d.eyebrow}>
        {d.types.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${t.id}`}
            tabindex={i === 0 ? 0 : -1}
            class="tabs__tab"
            data-tab
          >
            <span class="tabs__code">{t.code}</span>
            <span class="tabs__name">{t.name}</span>
          </button>
        ))}
      </div>

      {d.types.map((t, i) => (
        <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class="tabs__panel" tabindex="0" hidden={i !== 0} data-panel>
          <div class="tp">
            <div class="tp__visual">
              <figure class="tp__fig">
                <EarView type={t.id as 'bte'} label={fig.earLabel(t.name)} />
                <figcaption class="tp__cap">{behindEar(t.id) ? fig.behindEarNote : fig.inEarNote}</figcaption>
              </figure>
              {thumbFor(t.id) && (
                <Image src={thumbFor(t.id)!} alt={fig.thumbAlt(t.code)} widths={[140, 280]} sizes="70px" loading="lazy" decoding="async" class="tp__thumb" />
              )}
              <div class="tp__vis" data-visibility={t.visibility.level}>
                <span class="small muted">{th.visibility}</span>
                <span class="dots" role="img" aria-label={fig.visibilityAria(t.visibility.level, t.visibility.label)}>
                  {dots(t.visibility.level).map((on) => <i class:list={['dot', { on }]}></i>)}
                </span>
                <span class="tp__vislabel" aria-hidden="true">{t.visibility.label}</span>
              </div>
            </div>
            <div class="tp__body">
              <p class="pill">{t.code} · {t.short}</p>
              <h3>{t.name}</h3>
              <p class="tp__desc">{t.description}</p>
              <dl class="spec">
                <div><dt>{th.suits}</dt><dd>{t.suits}</dd></div>
                <div><dt>{th.power}</dt><dd>{t.power}</dd></div>
                <div><dt>{th.rechargeable}</dt><dd>{t.rechargeable}</dd></div>
                <div><dt>{th.wireless}</dt><dd>{t.wireless}</dd></div>
                <div><dt>{th.handling}</dt><dd>{t.handling}</dd></div>
                <div><dt>{th.care}</dt><dd>{t.care}</dd></div>
              </dl>
              {t.note && <p class="notice tp__note"><Icon name="info" />{t.note}</p>}
              <a class="btn btn--outline btn--sm mt-4" href="#iletisim" data-track="appointment_start" data-topic={t.code}><Icon name="message" />{d.askCta}</a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <details class="acc dt__compare reveal">
      <summary>{compareLabel}<span class="acc__chev"><Icon name="chevron-down" /></span></summary>
      <div class="acc__body dt__tablewrap" tabindex="0" role="region" aria-label={tableCaption}>
        <table class="cmp">
          <caption class="sr-only">{tableCaption}</caption>
          <thead>
            <tr>
              <td class="cmp__corner"></td>
              {d.types.map((t) => (
                <th scope="col">
                  <span class="cmp__head">
                    {thumbFor(t.id) && <Image src={thumbFor(t.id)!} alt="" widths={[56, 112]} sizes="56px" loading="lazy" decoding="async" class="cmp__thumb" />}
                    <span class="cmp__code">{t.code}</span>
                    <span class="cmp__name">{t.name}</span>
                  </span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">{th.visibility}</th>
              {d.types.map((t) => (
                <td>
                  <span class="dots" aria-hidden="true">{dots(t.visibility.level).map((on) => <i class:list={['dot', { on }]}></i>)}</span>
                  <span class="cmp__vis">{t.visibility.label}</span>
                </td>
              ))}
            </tr>
            <tr><th scope="row">{th.power}</th>{d.types.map((t) => <td>{t.power}</td>)}</tr>
            <tr><th scope="row">{th.rechargeable}</th>{d.types.map((t) => <td>{t.rechargeable}</td>)}</tr>
            <tr><th scope="row">{th.wireless}</th>{d.types.map((t) => <td>{t.wireless}</td>)}</tr>
            <tr><th scope="row">{th.handling}</th>{d.types.map((t) => <td>{t.handling}</td>)}</tr>
            <tr><th scope="row">{th.care}</th>{d.types.map((t) => <td>{t.care}</td>)}</tr>
          </tbody>
        </table>
      </div>
    </details>

    <div class="dt__systems reveal">
      <h3>{d.systems.title}</h3>
      <div class="grid grid--3 mt-5">
        {d.systems.items.map((s) => (
          <article class="card sysc">
            <div class:list={['sysc__vis', `sysc__vis--${s.id}`]} aria-hidden="true">
              {s.id === 'cros' && (
                <svg class="sysc__cros" viewBox="0 0 240 140">
                  <path class="sysc__wave" d="M44 70q-7 11 0 22M35 64q-11 17 0 34" />
                  <ellipse class="sysc__head" cx="120" cy="80" rx="44" ry="50" />
                  <path class="sysc__head" d="M112 32l8-11 8 11" />
                  <ellipse class="sysc__ear" cx="75" cy="81" rx="5" ry="12" />
                  <ellipse class="sysc__ear" cx="165" cy="81" rx="5" ry="12" />
                  <rect class="sysc__tx" x="58" y="66" width="11" height="28" rx="5.5" />
                  <circle cx="63.5" cy="71" r="2.2" fill="#8fd3da" />
                  <rect class="sysc__rx" x="171" y="66" width="11" height="28" rx="5.5" />
                  <path class="sysc__link" d="M64 60C76 0 164 0 176 60" />
                  <path class="sysc__arrow" d="M168 51l8 9 4-11" />
                  <path class="sysc__wave sysc__wave--in" d="M152 76q5 5 0 10" />
                </svg>
              )}
              {s.id === 'power' && thumbFor('bte') && (
                <>
                  <Image src={thumbFor('bte')!} alt="" widths={[100, 200]} sizes="88px" loading="lazy" decoding="async" class="sysc__img" />
                  <svg class="sysc__bars" viewBox="0 0 58 40">
                    {[8, 15, 22, 30, 40].map((h, i) => <rect x={i * 12} y={40 - h} width="8" height={h} rx="2" />)}
                  </svg>
                </>
              )}
              {s.id === 'kids' && (
                <span class="sysc__grow">
                  <Image src={moldImg} alt="" widths={[60, 120]} sizes="58px" loading="lazy" decoding="async" class="sysc__mold sysc__mold--s" />
                  <Icon name="arrow-right" />
                  <Image src={moldImg} alt="" widths={[100, 200]} sizes="92px" loading="lazy" decoding="async" class="sysc__mold" />
                </span>
              )}
            </div>
            <div class="sysc__body">
              <h4>{s.name}</h4>
              <p class="small muted">{s.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
    <p class="dt__disc small muted reveal"><Icon name="info" />{d.disclaimer}</p>
  </div>
</section>

<style>
  .tabs {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-1);
    overflow: hidden;
  }
  .tabs__list {
    display: flex;
    gap: 0.25rem;
    padding: 0.6rem;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--surface-2);
  }
  .tabs__list::-webkit-scrollbar {
    display: none;
  }
  .tabs__tab {
    flex: 1 0 auto;
    display: grid;
    gap: 0.05rem;
    text-align: left;
    padding: 0.6rem 0.9rem;
    min-height: 56px;
    border-radius: var(--r-md);
    color: var(--ink-2);
    transition: background var(--dur-1), color var(--dur-1), box-shadow var(--dur-1);
  }
  .tabs__tab:hover {
    background: rgba(255, 255, 255, 0.7);
  }
  .tabs__tab[aria-selected='true'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-1);
  }
  .tabs__code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .tabs__name {
    font-size: var(--text-xs);
  }
  .tabs__panel {
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    animation: fade-in var(--dur-2) var(--ease-out);
  }
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .tp {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 760px) {
    .tp {
      grid-template-columns: 260px minmax(0, 1fr);
    }
  }
  .tp__visual {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: var(--r-lg);
    background: var(--surface-2);
  }
  .tp__fig {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    width: 100%;
  }
  .tp__cap {
    max-width: 240px;
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--ink-2);
    text-align: center;
  }
  .tp__thumb {
    width: auto;
    height: 96px;
    max-width: 140px;
    object-fit: contain;
    filter: drop-shadow(0 8px 10px rgba(17, 43, 60, 0.18));
  }
  .tp__vis {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
  }
  .dots {
    display: inline-flex;
    gap: 4px;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .dot.on {
    background: var(--accent);
  }
  .tp__vislabel {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink);
  }
  .tp__body h3 {
    margin-top: 0.75rem;
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
  }
  .tp__desc {
    margin-top: 0.75rem;
    color: var(--ink-2);
    max-width: 64ch;
  }
  .spec {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.6rem 1.5rem;
  }
  @media (min-width: 640px) {
    .spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .spec > div:first-child {
      grid-column: 1 / -1;
    }
    /* Tek kalan son kart (Bakım ihtiyacı) satırı kaplasın: yanında boş hücre kalmaz */
    .spec > div:last-child:nth-child(even) {
      grid-column: 1 / -1;
    }
  }
  .spec div {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--r-md);
    background: var(--surface-2);
  }
  .spec dt {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-2);
  }
  .spec dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink);
  }
  /* Özellik kartlarından sonra gelen bilgi kutusu kartlara yapışmasın */
  .tp__note {
    margin-top: 1rem;
  }
  .dt__compare {
    margin-top: var(--space-6);
    border-bottom: 1px solid var(--line);
  }
  /* Genel "details.acc .acc__body" 70ch sınırı tabloyu yarıda bırakıyordu: burada tam genişlik */
  .dt__compare .dt__tablewrap {
    max-width: none;
    overflow-x: auto;
    padding: 0;
    margin-bottom: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
  }
  .cmp {
    border-collapse: collapse;
    width: 100%;
    min-width: 760px;
    table-layout: fixed;
    font-size: var(--text-sm);
  }
  .cmp th,
  .cmp td {
    padding: 0.75rem 0.6rem;
    border-bottom: 1px solid var(--line);
    text-align: center;
    vertical-align: middle;
  }
  .cmp tbody tr:last-child > * {
    border-bottom: 0;
  }
  .cmp__corner,
  .cmp tbody th {
    width: 9.5rem;
  }
  /* Üstten hizalı: görsel ve kod aynı çizgide, iki satıra kayan tür adı yalnız aşağı uzar */
  .cmp thead th,
  .cmp thead td {
    background: var(--surface-2);
    vertical-align: top;
    padding-top: 1rem;
  }
  .cmp__head {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
  }
  .cmp__thumb {
    width: auto;
    height: 52px;
    max-width: 64px;
    object-fit: contain;
    margin-bottom: 0.35rem;
    filter: drop-shadow(0 4px 6px rgba(17, 43, 60, 0.16));
  }
  .cmp__code {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--ink);
    font-size: 1rem;
  }
  .cmp__name {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--ink-2);
    line-height: 1.3;
  }
  .cmp tbody th {
    font-weight: 700;
    color: var(--ink);
    text-align: left;
    padding-left: 1rem;
  }
  /* Mobilde tablo yatay kayar; satır başlığı solda sabit kalır */
  .cmp tbody th,
  .cmp__corner {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--surface);
  }
  .cmp__corner {
    background: var(--surface-2);
  }
  @media (max-width: 639px) {
    .cmp {
      min-width: 640px;
      font-size: var(--text-xs);
    }
    .cmp__corner,
    .cmp tbody th {
      width: 6.5rem;
      padding-left: 0.75rem;
    }
  }
  .cmp td .dots {
    display: flex;
    justify-content: center;
    margin-bottom: 0.3rem;
  }
  .cmp__vis {
    font-weight: 600;
    color: var(--ink);
  }
  .dt__systems {
    margin-top: var(--space-7);
  }
  .sysc {
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
  }
  .sysc__vis {
    position: relative;
    height: 150px;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, var(--accent-soft) 0%, var(--surface) 100%);
  }
  .sysc__cros {
    width: min(100%, 240px);
    height: auto;
  }
  .sysc__head,
  .sysc__ear {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 2;
  }
  path.sysc__head {
    fill: none;
  }
  .sysc__tx {
    fill: var(--navy);
  }
  .sysc__rx {
    fill: var(--accent);
  }
  .sysc__link {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-dasharray: 6 6;
  }
  .sysc__arrow,
  .sysc__wave {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sysc__wave {
    stroke: var(--ink-3);
  }
  .sysc__wave--in {
    stroke: var(--accent);
  }
  .sysc__img {
    width: auto;
    height: 120px;
    object-fit: contain;
    filter: drop-shadow(0 8px 10px rgba(17, 43, 60, 0.18));
  }
  .sysc__bars {
    position: absolute;
    right: 18%;
    bottom: 22px;
    width: 46px;
    fill: var(--accent);
  }
  .sysc__bars rect:nth-child(-n + 2) {
    fill: var(--accent-soft-2);
  }
  .sysc__grow {
    display: flex;
    align-items: flex-end;
    gap: 0.9rem;
    color: var(--accent);
  }
  /* Icon ayrı bileşen: kapsamlı stil onun <svg>'sine ulaşmaz, bu yüzden :global(.icon) */
  .sysc__grow :global(.icon) {
    align-self: center;
  }
  /* Silikon kalıp render'ı beyaz zeminli: multiply ile gradyana dikişsiz oturur */
  .sysc__mold {
    width: auto;
    height: 104px;
    mix-blend-mode: multiply;
  }
  .sysc__mold--s {
    height: 64px;
  }
  .sysc__body {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.1rem 1.25rem 1.35rem;
  }
  .sysc__body h4 {
    font-size: 1.1rem;
  }
  .dt__disc {
    display: flex;
    gap: 0.5rem;
    margin-top: var(--space-5);
    max-width: 80ch;
  }
  .dt__disc :global(.icon) {
    flex: none;
    margin-top: 0.2em;
  }
</style>
