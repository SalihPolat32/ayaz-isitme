---
import type { Locale, SiteContent } from '../content/types';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { locale: Locale; c: SiteContent }
const { c } = Astro.props;
const br = c.brands;
const techIcons = ['users', 'battery', 'bluetooth', 'phone', 'volume', 'ear'] as const;
/**
 * Resmî marka logosu YALNIZCA marka sahibinin veya distribütörün yazılı kullanım izniyle
 * src/assets/brands/<marka-adı>.svg|png|webp olarak eklenir (ör. phonak.svg). Dosya yoksa ad yazıyla gösterilir.
 * Marka bölümünün kendisi hukuk incelemesinde (CONTENT-VERIFICATION.md) — logo eklemeden önce o karar beklenir.
 */
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/brands/*.{svg,png,webp}', { eager: true });
const slug = (n: string) => n.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const logoFor = (n: string): ImageMetadata | null =>
  Object.entries(logos).find(([k]) => k.split('/').pop()!.replace(/\.\w+$/, '') === slug(n))?.[1].default ?? null;
const wall = br.groups.flatMap((g) => g.brands.map((name) => ({ name, label: g.label, logo: logoFor(name) })));
---

<section class="section bx" id="markalar" aria-labelledby="bx-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{br.eyebrow}</p>
      <h2 id="bx-title">{br.h2}</h2>
      <p class="lead">{br.lead}</p>
    </div>

    <h3 class="sr-only">{br.wallTitle}</h3>
    <ul class="bx__wall reveal" role="list">
      {wall.map((b) => (
        <li class="bx__tile">
          {b.logo ? (
            <Image src={b.logo} alt={b.name} height={36} class="bx__logo" />
          ) : (
            <span class:list={['bx__word', { 'bx__word--long': b.name.length > 12 }]}>{b.name}</span>
          )}
          <span class="bx__group">{b.label}</span>
        </li>
      ))}
    </ul>
    <p class="bx__disc small muted reveal"><Icon name="info" />{br.disclaimer}</p>

    <div class="bx__techwrap reveal">
      <h3>{br.techTitle}</h3>
      <ul class="bx__tech" role="list">
        {br.tech.map((t, i) => (
          <li class="bx__techcard">
            <span class="bx__techicon"><Icon name={techIcons[i % techIcons.length]} /></span>
            <strong>{t.name}</strong>
            <span class="small muted">{t.text}</span>
          </li>
        ))}
      </ul>
      <p class="small muted mt-4">{br.techNote}</p>
    </div>
  </div>
</section>

<style>
  .bx__wall {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .bx__wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .bx__wall {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .bx__tile {
    min-height: 116px;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    align-items: center;
    gap: 0.4rem;
    padding: 1.1rem 0.75rem 0.9rem;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .bx__tile:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-2);
  }
  .bx__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.55rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
  }
  .bx__word--long {
    font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.1rem);
    letter-spacing: -0.01em;
  }
  .bx__logo {
    width: auto;
    max-width: 100%;
    height: 36px;
    object-fit: contain;
  }
  /* Grup adı: iki satıra kaysa da yüksekliği sabit → komşu kutulardaki marka adları hizalı kalır */
  .bx__group {
    align-self: start;
    min-height: 2.6em;
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink-2);
  }
  .bx__disc {
    display: flex;
    gap: 0.5rem;
    margin-top: var(--space-4);
    max-width: 80ch;
  }
  /* Icon ayrı bileşen: kapsamlı stil onun <svg>'sine ulaşmaz, bu yüzden :global(.icon) */
  .bx__disc :global(.icon) {
    flex: none;
    margin-top: 0.2em;
  }
  .bx__techwrap {
    margin-top: var(--space-8);
  }
  .bx__tech {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .bx__tech {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .bx__tech {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .bx__techcard {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.9rem;
    row-gap: 0.15rem;
    align-items: center;
    padding: 1rem 1.1rem;
    border-radius: var(--r-lg);
    background: var(--surface-2);
  }
  .bx__techicon {
    grid-row: 1 / span 2;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: #fff;
  }
  .bx__techicon :global(.icon) {
    width: 1.4rem;
    height: 1.4rem;
  }
  .bx__techcard strong {
    font-family: var(--font-display);
    font-weight: 700;
    align-self: end;
  }
  .bx__techcard .small {
    align-self: start;
    line-height: 1.4;
  }
</style>
