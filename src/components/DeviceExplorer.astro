---
import { Image } from 'astro:assets';
import type { Locale, SiteContent } from '../content/types';
import Icon from './Icon.astro';
import posterRic from '../assets/device/ric-poster.png';
import posterBte from '../assets/device/bte-poster.png';
import posterCic from '../assets/device/cic-poster.png';

interface Props { locale: Locale; c: SiteContent }
const { c } = Astro.props;
const x = c.explorer;
const posters = { ric: posterRic, bte: posterBte, cic: posterCic } as const;
const active = 'ric';
---

<section class="section xp" id="incele" aria-labelledby="xp-title" data-explorer data-state="idle" data-model={active}>
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{x.eyebrow}</p>
      <h2 id="xp-title">{x.h2}</h2>
      <p class="lead">{x.lead}</p>
    </div>

    <div class="xp__switch reveal" role="group" aria-label={x.controls.modelLabel}>
      {x.models.map((m) => (
        <button type="button" class="xp__tab" data-model-btn={m.id} aria-pressed={m.id === active ? 'true' : 'false'}>
          <span class="xp__tabcode">{m.label}</span>
          <span class="xp__tabsub">{m.sub}</span>
        </button>
      ))}
    </div>

    <div class="xp__grid">
      <div class="xp__stagewrap reveal">
        <div class="xp__stage" data-stage>
          {x.models.map((m) => (
            <Image src={posters[m.id]} alt={m.caption} widths={[480, 640, 800, 1000]} sizes="(min-width: 1000px) 624px, 78vw" loading="lazy" decoding="async" class="xp__poster" data-poster data-poster-for={m.id} hidden={m.id !== active} />
          ))}
          <canvas class="xp__canvas" data-canvas tabindex="-1" aria-hidden="true" role="img" aria-label={x.models[0]!.caption + ' — ' + x.keyboardHint} data-hint={x.keyboardHint}></canvas>
          <div class="xp__hotspots" data-hotspots>
            {x.models.map((m) => (
              <div data-hotspots-for={m.id} hidden={m.id !== active}>
                {m.hotspots.map((h, i) => (
                  <button type="button" class="hs" data-hotspot={h.id} tabindex="-1" aria-label={`${i + 1}. ${h.title}`} hidden>
                    <span class="hs__dot">{i + 1}</span>
                  </button>
                ))}
              </div>
            ))}
          </div>
          <div class="xp__loading" data-loading><span class="spinner" aria-hidden="true"></span>{x.loading}</div>
          <button type="button" class="xp__start btn btn--navy" data-start><Icon name="rotate" />{x.controls.rotate} · 360°</button>
          <div class="xp__fallback" data-fallback hidden>
            <Icon name="info" />
            <div>
              <strong data-fallback-title data-load-title={x.loadErrorTitle}>{x.fallbackTitle}</strong>
              <p data-fallback-text data-load-text={x.loadErrorText}>{x.fallbackText}</p>
              <button type="button" class="btn btn--outline xp__reload" data-reload hidden>{x.reloadLabel}</button>
            </div>
          </div>
        </div>
        {x.models.map((m) => (
          <p class="xp__caption small muted" data-caption-for={m.id} hidden={m.id !== active}>{m.caption}</p>
        ))}

        <div class="xp__controls" data-controls>
          <div class="xp__range">
            <label for="xp-explode">{x.controls.explodeLabel}</label>
            <input type="range" id="xp-explode" min="0" max="100" value="0" step="1" data-explode-range aria-valuetext="0%" />
          </div>
          <div class="xp__buttons">
            <button type="button" class="btn btn--outline btn--sm" data-door aria-pressed="false"><Icon name="battery" /><span>{x.controls.door}</span></button>
            <button type="button" class="btn btn--outline btn--sm" data-explode-toggle aria-pressed="false"><Icon name="layers" /><span>{x.controls.explode}</span></button>
            <button type="button" class="btn btn--outline btn--sm" data-reset><Icon name="refresh" />{x.controls.reset}</button>
            <button type="button" class="btn btn--outline btn--sm" data-autorotate aria-pressed="true"><Icon name="play" />{x.controls.autoRotate}</button>
          </div>
          <p class="xp__hint"><Icon name="keyboard" />{x.keyboardHint}</p>
        </div>
        <p class="xp__note"><Icon name="info" />{x.representativeNote}</p>
      </div>

      <div class="xp__side reveal" style="--reveal-delay:120ms">
        {x.models.map((m) => (
          <ol class="xp__parts" data-parts data-parts-for={m.id} hidden={m.id !== active}>
            {m.hotspots.map((h, i) => (
              <li>
                <details class="part" data-part={h.id} name={`xp-part-${m.id}`}>
                  <summary>
                    <span class="part__num">{i + 1}</span>
                    <span class="part__title">{h.title}</span>
                    <span class="acc__chev"><Icon name="chevron-down" /></span>
                  </summary>
                  <p class="part__text">{h.text}</p>
                </details>
              </li>
            ))}
          </ol>
        ))}
        <a class="btn btn--primary xp__cta" href="#iletisim" data-track="appointment_start"><Icon name="calendar" />{x.cta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .xp__switch {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.35rem;
    border-radius: var(--r-pill);
    background: var(--surface-2);
    border: 1px solid var(--line);
    margin-bottom: var(--space-5);
  }
  /* Dar ekranda üç eşit sütun (sarılıp oval bir kütleye dönüşmez); yuvarlak köşe dikdörtgen */
  @media (max-width: 799px) {
    .xp__switch {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      border-radius: var(--r-lg);
    }
    .xp__switch .xp__tab {
      border-radius: var(--r-md);
      padding-inline: 0.6rem;
    }
  }
  .xp__tab {
    display: grid;
    gap: 0.05rem;
    padding: 0.55rem 1.1rem;
    min-height: 52px;
    border-radius: var(--r-pill);
    color: var(--ink-2);
    text-align: left;
    transition: background var(--dur-1), color var(--dur-1), box-shadow var(--dur-1);
  }
  .xp__tab:hover {
    background: rgba(255, 255, 255, 0.7);
  }
  .xp__tab[aria-pressed='true'] {
    background: var(--navy);
    color: #fff;
    box-shadow: var(--shadow-1);
  }
  .xp__tabcode {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .xp__tabsub {
    font-size: var(--text-xs);
    opacity: 0.85;
  }
  /* Telefonda yalnız kod (RIC / BTE / CIC): alt yazı 3–4 satıra sarılmasın; tam ad sahnenin altındaki açıklamada */
  @media (max-width: 479px) {
    .xp__tabsub {
      display: none;
    }
    .xp__tab {
      min-height: 44px;
      text-align: center;
    }
  }
  .xp__grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .xp__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
      gap: var(--space-7);
    }
  }
  .xp__stage {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--r-xl);
    background: radial-gradient(120% 90% at 50% 40%, #ffffff 0%, #eef3f2 55%, #e4ebea 100%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .xp__stage {
      aspect-ratio: 4 / 3;
    }
  }
  .xp__poster {
    position: absolute;
    inset: 8%;
    width: 84%;
    height: 84%;
    object-fit: contain;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .xp__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease-out);
    touch-action: pan-y;
    cursor: grab;
    outline-offset: -4px;
  }
  .xp__canvas:active {
    cursor: grabbing;
  }
  [data-state='ready'] .xp__canvas {
    opacity: 1;
  }
  [data-state='ready'] .xp__poster {
    opacity: 0;
  }
  .xp__caption {
    margin-top: 0.6rem;
  }
  .xp__hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hs {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(calc(var(--x, 0px) - 50%), calc(var(--y, 0px) - 50%));
    pointer-events: auto;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity var(--dur-2);
  }
  .hs.is-visible {
    opacity: 1;
  }
  .hs__dot {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8rem;
    display: grid;
    place-items: center;
    box-shadow:
      0 0 0 4px rgba(255, 255, 255, 0.9),
      0 6px 14px rgba(17, 43, 60, 0.3);
    transition: transform var(--dur-1), background var(--dur-1);
  }
  .hs:hover .hs__dot,
  .hs.is-active .hs__dot {
    background: var(--accent);
    transform: scale(1.12);
  }
  .xp__loading {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.9);
    font-size: var(--text-xs);
    color: var(--ink-2);
    box-shadow: var(--shadow-1);
  }
  [data-state='loading'] .xp__loading {
    display: inline-flex;
  }
  .spinner {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--accent-soft-2);
    border-top-color: var(--accent);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .xp__start {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
  }
  [data-state='loading'] .xp__start,
  [data-state='ready'] .xp__start,
  [data-state='error'] .xp__start {
    display: none;
  }
  .xp__fallback {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.95);
    box-shadow: var(--shadow-2);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .xp__reload {
    margin-top: 0.75rem;
  }
  /* Icon ayrı bileşen: kapsamlı stil onun <svg>'sine ulaşmaz, bu yüzden :global(.icon) */
  .xp__fallback :global(.icon) {
    flex: none;
    color: var(--accent);
    margin-top: 0.15em;
  }
  .xp__fallback strong {
    color: var(--ink);
  }
  .xp__controls {
    margin-top: var(--space-4);
    display: grid;
    gap: 0.75rem;
  }
  [data-state='error'] .xp__controls,
  [data-state='idle'] .xp__controls {
    display: none;
  }
  .xp__range {
    display: grid;
    gap: 0.35rem;
  }
  .xp__range label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-2);
  }
  .xp__range input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
    height: 32px;
  }
  .xp__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .xp__buttons [aria-pressed='true'] {
    --btn-bg: var(--accent-soft);
    --btn-bd: var(--accent);
    --btn-fg: var(--accent-text);
  }
  .xp__hint {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .xp__hint :global(.icon) {
    flex: none;
  }
  .xp__note {
    display: flex;
    gap: 0.5rem;
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .xp__note :global(.icon) {
    flex: none;
    margin-top: 0.1em;
  }
  .xp__parts {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .part {
    border-bottom: 1px solid var(--line);
  }
  .part summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 0.25rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
  }
  .part summary::-webkit-details-marker {
    display: none;
  }
  .part__num {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    color: var(--ink);
    font-size: 0.8rem;
    transition: background var(--dur-1), color var(--dur-1);
  }
  .part[open] .part__num,
  .part.is-active .part__num {
    background: var(--accent);
    color: #fff;
  }
  .part__title {
    flex: 1;
  }
  .part .acc__chev {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .part[open] .acc__chev {
    transform: rotate(180deg);
  }
  .part__text {
    padding: 0 0.25rem 1rem 2.8rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .xp__cta {
    margin-top: var(--space-5);
    width: 100%;
  }
</style>
