---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale, SiteContent } from '../content/types';
import { business, canShow } from '../config/business';
import Icon from './Icon.astro';

interface Props { locale: Locale; c: SiteContent }
const { locale, c } = Astro.props;
const ce = c.center;

// Yalnız sitede kullanılan fotoğraflar (galeri + ekip kartı). Joker (*.jpg) kullanılmaz: içe aktarılan her görselin
// özgünü derlemeye kopyalanıyordu (kullanılmayan ofis-2, ofis-4 ≈ 0,7 MB). Yeni fotoğraf eklerken listeye ekleyin.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/ofis/ofis-{1,3,5,6,7,8}.jpg', { eager: true });
const byKey = (k: string): ImageMetadata => {
  const m = photos[`../assets/ofis/${k}.jpg`];
  if (!m) throw new Error(`Fotoğraf bulunamadı ya da Center.astro listesinde yok: ${k}`);
  return m.default;
};
const items = await Promise.all(
  ce.photos.map(async (p) => ({
    ...p,
    src: byKey(p.key),
    // Büyütme görseli tek dosya: genel layout 'constrained' getImage'a da srcset ürettiriyordu (kullanılmayan ≈ MB'larca varyant)
    full: await getImage({ src: byKey(p.key), width: 1600, format: 'webp', quality: 80, layout: 'none' }),
  })),
);
const [main, ...rest] = items;
const team = business.team.filter((t) => canShow(t));
const teamPhoto = team[0] ? byKey(team[0].photo) : null;
const openLabel = locale === 'tr' ? 'Fotoğrafı büyüt' : 'Enlarge photo';
---

<section class="section ct" id="merkezimiz" aria-labelledby="ct-title">
  <div class="container">
    <div class="ct__head reveal">
      <div>
        <p class="eyebrow">{ce.eyebrow}</p>
        <h2 id="ct-title">{ce.h2}</h2>
        <p class="lead">{ce.lead}</p>
      </div>
      <div class="ct__facts">
        <dl>
          {ce.facts.map((f) => (
            <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
          ))}
        </dl>
        <div class="ct__factcta">
          <a class="btn btn--outline btn--sm" href={business.google.directionsUrl} target="_blank" rel="noopener" data-track="directions_click"><Icon name="navigation" />{ce.directionsCta}</a>
        </div>
      </div>
    </div>

    <div class="gal reveal" data-gallery role="group" aria-label={ce.galleryLabel}>
      <figure class="gal__item gal__item--main">
        <button type="button" class="gal__btn" data-full={main.full.src} data-alt={main.alt} data-caption={main.caption} aria-label={openLabel + ': ' + main.caption}>
          <Image src={main.src} alt={main.alt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1240px) 600px, (min-width: 1000px) 50vw, 100vw" loading="lazy" decoding="async" />
        </button>
        <figcaption>{main.caption}</figcaption>
      </figure>
      {rest.map((p, i) => (
        <figure class="gal__item">
          <button type="button" class="gal__btn" data-full={p.full.src} data-alt={p.alt} data-caption={p.caption} aria-label={openLabel + ': ' + p.caption}>
            {i === rest.length - 1 ? (
              // Son küçük fotoğraf iki sütun kaplar: boyut ipucu da iki sütunluk
              <Image src={p.src} alt={p.alt} widths={[480, 800, 1200]} sizes="(min-width: 1240px) 400px, (min-width: 1000px) 32vw, (min-width: 640px) 66vw, 100vw" loading="lazy" decoding="async" />
            ) : (
              <Image src={p.src} alt={p.alt} widths={[320, 480, 800]} sizes="(min-width: 1240px) 200px, (min-width: 1000px) 16vw, (min-width: 640px) 33vw, 50vw" loading="lazy" decoding="async" />
            )}
          </button>
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>

    {team.length > 0 && (
      <div class="team reveal">
        {teamPhoto && (
          <div class="team__photo">
            <Image src={teamPhoto} alt={team[0]!.name} widths={[320, 480, 800]} sizes="(min-width: 800px) 320px, 100vw" loading="lazy" decoding="async" />
          </div>
        )}
        <div class="team__body">
          <p class="eyebrow">{ce.teamTitle}</p>
          <h3>{canShow(team[0]!.title) ? team[0]!.titleShort + ' ' : ''}{team[0]!.name}</h3>
          <p class="muted">{ce.teamText}</p>
        </div>
      </div>
    )}
  </div>

  <dialog class="lb" data-lightbox aria-label={ce.galleryLabel}>
    <button type="button" class="lb__close btn btn--icon btn--white" data-lb-close aria-label={c.common.close}><Icon name="x" /></button>
    <button type="button" class="lb__nav lb__nav--prev" data-lb-prev aria-label={c.common.prev}><Icon name="chevron-left" /></button>
    <figure class="lb__fig">
      <img data-lb-img alt="" />
      <figcaption data-lb-cap aria-live="polite"></figcaption>
    </figure>
    <button type="button" class="lb__nav lb__nav--next" data-lb-next aria-label={c.common.next}><Icon name="chevron-right" /></button>
  </dialog>
</section>

<style>
  .ct__head {
    display: grid;
    gap: var(--space-6);
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 900px) {
    .ct__head {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
  .ct__facts dl {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .ct__facts {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
  }
  /* Yalnız bilgi satırları (dl > div); alttaki "Yol tarifi" kutusuna ayraç çizgisi düşmez */
  .ct__facts dl > div {
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ct__facts dt {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .ct__facts dd {
    margin: 0;
    font-weight: 600;
  }
  .ct__factcta {
    padding-top: 0.5rem;
  }
  /* Galeri: ana fotoğraf + 5 küçük; hiçbir kırılımda boş hücre kalmaz (son küçük gerekirse iki sütun kaplar) */
  .gal {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, 1fr);
  }
  .gal__item {
    margin: 0;
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--surface-2);
  }
  .gal__item--main {
    grid-column: span 2;
  }
  /* 2 sütun: ana (2) + 2 + 2 + 1 → son küçük tam genişlik (yalnız bir satırda: 3/2) */
  .gal__item:last-child {
    grid-column: span 2;
  }
  .gal__item:last-child .gal__btn {
    aspect-ratio: 3 / 2;
  }
  @media (min-width: 640px) {
    /* Yanındaki tek sütunlu 4:3 kutuyla aynı satır yüksekliği: 2 × 3/8 = 3/4 */
    .gal__item:last-child .gal__btn {
      aspect-ratio: 8 / 3;
    }
  }
  @media (min-width: 640px) and (max-width: 999px) {
    /* 3 sütun: ana (3) + 3 + 2 → son küçük iki sütun */
    .gal {
      grid-template-columns: repeat(3, 1fr);
    }
    .gal__item--main {
      grid-column: span 3;
    }
  }
  @media (min-width: 1000px) {
    /* 6 sütun: ana 3×2 (sol yarı), sağda 3 + 2 → son küçük iki sütun */
    .gal {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: 1fr;
    }
    .gal__item--main {
      grid-column: span 3;
      grid-row: span 2;
    }
  }
  .gal__btn {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
  }
  .gal__item--main .gal__btn {
    aspect-ratio: 16 / 10;
  }
  .gal__btn :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .gal__btn:hover :global(img) {
    transform: scale(1.03);
  }
  .gal__btn:focus-visible {
    outline-offset: -4px;
  }
  .gal figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--r-pill);
    background: rgba(17, 43, 60, 0.75);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 600;
    pointer-events: none;
  }
  /* Dar ekranda küçük kutularda altyazı tek satır (fotoğrafın yarısını örtmesin); tamamı büyütmede ve düğme adında */
  @media (max-width: 639px) {
    .gal__item:not(.gal__item--main) figcaption {
      right: 0.5rem;
      left: 0.5rem;
      bottom: 0.5rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
  .team {
    margin-top: var(--space-7);
    display: grid;
    gap: var(--space-5);
    padding: 1.5rem;
    border-radius: var(--r-xl);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
    align-items: center;
  }
  @media (min-width: 800px) {
    .team {
      grid-template-columns: 320px 1fr;
    }
  }
  .team__photo {
    border-radius: var(--r-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .team__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .team__body h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  /* Lightbox */
  .lb {
    border: 0;
    padding: 0;
    margin: auto;
    max-width: min(96vw, 1400px);
    max-height: 96vh;
    background: transparent;
    overflow: visible;
  }
  .lb::backdrop {
    background: rgba(12, 31, 44, 0.92);
  }
  .lb__fig {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }
  .lb__fig img {
    max-width: 96vw;
    max-height: 84vh;
    width: auto;
    height: auto;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-3);
  }
  .lb__fig figcaption {
    color: #fff;
    font-size: var(--text-sm);
  }
  .lb__close {
    position: fixed;
    top: 1rem;
    right: 1rem;
  }
  .lb__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .lb__nav:hover {
    background: rgba(255, 255, 255, 0.28);
  }
  .lb__nav--prev {
    left: 1rem;
  }
  .lb__nav--next {
    right: 1rem;
  }
</style>
