---
/**
 * GELİŞTİRME SAYFASI — 3B cihaz görüntüleyici testi.
 * Sitemap'ten hariç (/dev/), noindex. Üretim bileşeni değildir.
 */
import '../../styles/global.css';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Dev · 3B cihaz görüntüleyici</title>
    <style>
      .wrap {
        max-width: 960px;
        margin: 0 auto;
        padding: var(--space-6) var(--gutter);
      }
      h1 {
        font-family: var(--font-display);
        font-size: var(--h3);
        margin: 0 0 var(--space-4);
      }
      .stage {
        position: relative;
        width: 720px;
        height: 520px;
        max-width: 100%;
        border-radius: var(--r-lg);
        background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%);
        box-shadow: var(--shadow-2);
        overflow: hidden;
      }
      .stage canvas {
        display: block;
        width: 100%;
        height: 100%;
        outline: none;
        cursor: grab;
      }
      .stage canvas:focus-visible {
        box-shadow: inset var(--ring);
      }
      .hotspots {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .dot {
        position: absolute;
        left: 0;
        top: 0;
        pointer-events: auto;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transform: translate(-50%, -50%);
        transition: opacity var(--dur-1) var(--ease-out);
        cursor: pointer;
        border: 0;
        background: none;
        padding: 0;
        font: inherit;
        color: var(--ink);
      }
      .dot[data-hidden='true'] {
        opacity: 0;
        pointer-events: none;
      }
      .dot i {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 4px rgba(8, 127, 140, 0.25), var(--shadow-1);
      }
      .dot span {
        font-size: var(--text-xs);
        background: rgba(255, 255, 255, 0.92);
        padding: 2px 8px;
        border-radius: var(--r-pill);
        box-shadow: var(--shadow-1);
        white-space: nowrap;
      }
      .status {
        position: absolute;
        left: 12px;
        bottom: 8px;
        margin: 0;
        font-size: var(--text-xs);
        color: var(--ink-3);
        pointer-events: none;
      }
      .controls {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        align-items: center;
        margin-top: var(--space-4);
      }
      .controls button {
        font: inherit;
        padding: 6px 14px;
        border-radius: var(--r-pill);
        border: 1px solid var(--line-strong);
        background: var(--surface);
        cursor: pointer;
      }
      .controls input[type='range'] {
        width: 220px;
      }
      .meta {
        font-size: var(--text-sm);
        color: var(--ink-2);
      }
      #capture {
        max-width: 100%;
        margin-top: var(--space-4);
        border: 1px solid var(--line);
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <h1>3B cihaz görüntüleyici (dev)</h1>
      <div class="stage" id="stage">
        <canvas id="viewer-canvas" tabindex="0" aria-label="Temsili RIC işitme cihazı, döndürülebilir 3B model"></canvas>
        <div class="hotspots" id="hotspots" aria-hidden="true"></div>
        <p class="status" id="status">Yükleniyor…</p>
      </div>
      <div class="controls">
        <label>Parçala <input id="explode" type="range" min="0" max="100" value="0" /></label>
        <button id="btn-explode" type="button">Parçala</button>
        <button id="btn-assemble" type="button">Birleştir</button>
        <button id="btn-reset" type="button">Sıfırla</button>
        <button id="btn-capture" type="button">Poster yakala (1200×900)</button>
        <label><input id="autorotate" type="checkbox" checked /> Otomatik dön</label>
      </div>
      <p class="meta" id="meta">Klavye: ← → ↑ ↓ döndür · + − yaklaştır · r sıfırla · e parçala. Noktalara tıklayınca parçaya odaklanır.</p>
      <img id="capture" alt="" hidden />
    </main>

    <script>
      import type { PartId, ViewerController } from '../../scripts/viewer/types.ts';

      const LABELS: Record<PartId, string> = {
        mics: 'Mikrofonlar',
        body: 'Gövde',
        button: 'Düğme',
        wire: 'Alıcı kablosu',
        receiver: 'Alıcı',
        dome: 'Dome',
        power: 'Şarj kontakları',
      };

      const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;
      const stage = $<HTMLDivElement>('stage');
      const canvas = $<HTMLCanvasElement>('viewer-canvas');
      const hotspots = $<HTMLDivElement>('hotspots');
      const status = $<HTMLParagraphElement>('status');
      const range = $<HTMLInputElement>('explode');
      const autorotate = $<HTMLInputElement>('autorotate');
      const captureImg = $<HTMLImageElement>('capture');

      const dots = new Map<PartId, HTMLButtonElement>();
      for (const id of Object.keys(LABELS) as PartId[]) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'dot';
        b.dataset.part = id;
        b.dataset.hidden = 'true';
        b.innerHTML = `<i></i><span>${LABELS[id]}</span>`;
        hotspots.appendChild(b);
        dots.set(id, b);
      }

      const { mountDeviceViewer, isWebGLAvailable } = await import('../../scripts/viewer/index.ts');

      if (!isWebGLAvailable()) {
        status.textContent = 'WebGL2 yok — statik poster gösterilecek.';
      } else {
        let controller: ViewerController | null = null;
        let syncingRange = false;

        controller = await mountDeviceViewer(stage, {
          canvas,
          onReady: () => {
            status.textContent = 'Hazır';
          },
          onInteract: () => {
            status.textContent = 'Etkileşim algılandı (otomatik dönüş durdu)';
          },
          onHotspot: (id, x, y, visible) => {
            const el = dots.get(id);
            if (!el) return;
            el.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) translate(-50%, -50%)`;
            el.dataset.hidden = visible ? 'false' : 'true';
          },
        });

        for (const [id, el] of dots) {
          el.addEventListener('click', () => controller?.focusPart(id));
        }

        range.addEventListener('input', () => {
          if (syncingRange) return;
          controller?.setExplode(Number(range.value) / 100, false);
        });
        $('btn-explode').addEventListener('click', () => controller?.explode());
        $('btn-assemble').addEventListener('click', () => controller?.assemble());
        $('btn-reset').addEventListener('click', () => controller?.reset());
        $('btn-capture').addEventListener('click', () => {
          const url = controller?.captureImage(1200, 900) ?? '';
          if (url) {
            captureImg.src = url;
            captureImg.hidden = false;
          }
        });
        autorotate.addEventListener('change', () => controller?.setAutoRotate(autorotate.checked));

        // Kaydırıcıyı tween ile senkron tut
        const tick = () => {
          if (controller) {
            syncingRange = true;
            range.value = String(Math.round(controller.getExplode() * 100));
            syncingRange = false;
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    </script>
  </body>
</html>
