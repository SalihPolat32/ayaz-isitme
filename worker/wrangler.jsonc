{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ayaz-isitme-api",
  "main": "src/index.ts",
  // 2026-08-04 ve sonrası: nodejs_compat varsayılan olarak açık; bu Worker Node API'si kullanmaz.
  "compatibility_date": "2026-09-01",

  // Workers Logs: yalnızca Worker'ın kendi console satırları (maskeli telefon, ülke kodu, iletim sonucu, hata özetleri).
  // Gizlilik varsayılanı: otomatik çağrı (invocation) logları KAPALI — bunlar her istek için istek üst verisini
  // (yöntem, URL, başlıklar vb.) kaydeder ve gizlilik metninde anlatılmaz. İzleme (traces) de kapalı.
  // Açmak gizlilik metninin güncellenmesini gerektirir (CONTENT-VERIFICATION.md §7).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },

  // ---- Yönlendirme -------------------------------------------------------------
  // Varsayılan: <name>.<hesap>.workers.dev adresi. Alan adı Cloudflare DNS'e taşınınca
  // aşağıdaki iki satırı açın (bkz. README "Özel alan adı").
  // "routes": [{ "pattern": "api.keciorenisitme.com", "custom_domain": true }],
  // "workers_dev": false,

  // ---- Düz metin değişkenler (gizli değil) ------------------------------------
  "vars": {
    // Virgülle ayrılmış izinli kaynaklar (CORS). Şema+host, sonda / olmadan.
    "ALLOWED_ORIGINS": "https://keciorenisitme.com,http://localhost:4321",
    // "resend" | "brevo" | "mock" — ilgili API anahtarı yoksa otomatik "mock"a düşer.
    "MAIL_PROVIDER": "mock",
    // Resend/Brevo'da DOĞRULANMIŞ bir alan adından olmalı (gmail.com gönderici olamaz).
    "MAIL_FROM": "Ayaz Isitme Randevu <randevu@keciorenisitme.com>",
    "MAIL_TO": "ayazisitmecihazlari@gmail.com",
    // Yorum önbelleği (saniye). 0 = KAPALI: her istek Google'a canlı gider (eşzamanlılar birleştirilir).
    // Google Maps Platform şartları yalnızca Place ID'nin saklanmasına açıkça izin verir; yorum
    // içeriğini uçta tutmak (ör. "21600" = 6 sa) işletme sahibinin uyum kararıdır — bkz. README §5.3.
    "REVIEWS_CACHE_TTL": "0",
    // Önbellek açıkken Google hata verirse eski kopyanın en fazla ne kadar daha sunulacağı (saniye).
    "REVIEWS_CACHE_STALE_TTL": "0"
  },

  // ---- Hız sınırı (Workers Rate Limiting binding, GA, ücretsiz) ---------------
  // Ek kaynak oluşturmaya gerek yok; deploy ile birlikte gelir. IP başına: form 5/60 sn, yorumlar 30/60 sn.
  // period yalnızca 10 veya 60 olabilir. namespace_id hesap içinde benzersiz pozitif tamsayı.
  "ratelimits": [
    { "name": "APPT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "REVIEWS_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]

  // ---- İsteğe bağlı KV (yalnızca rate-limit binding'i kaldırılırsa yedek sayaç) ----
  // Oluşturma: npx wrangler kv namespace create RATE_KV  -> çıkan id'yi buraya yapıştırın.
  // Free planda günde 1.000 KV yazma sınırı vardır; her form isteği 1 yazma harcar.
  // "kv_namespaces": [
  //   { "binding": "RATE_KV", "id": "<KV_NAMESPACE_ID>" }
  // ],

  // ---- Gizli değerler (secrets) ------------------------------------------------
  // Bu dosyaya YAZILMAZ. Üretim: npx wrangler secret put <AD>   Yerel: .dev.vars
  //   RESEND_API_KEY         Resend API anahtarı (MAIL_PROVIDER=resend)
  //   BREVO_API_KEY          Brevo API anahtarı (MAIL_PROVIDER=brevo)
  //   TURNSTILE_SECRET_KEY   Cloudflare Turnstile gizli anahtarı (boşsa doğrulama atlanır)
  //   GOOGLE_PLACES_API_KEY  Google Places API (New) sunucu anahtarı
  //   GOOGLE_PLACE_ID        İşletmenin Place ID'si (ChIJ...) — boşsa /api/reviews 503 döner
  //   TELEGRAM_BOT_TOKEN     İsteğe bağlı: Telegram bot token'ı
  //   TELEGRAM_CHAT_ID       İsteğe bağlı: bildirim gönderilecek sohbet kimliği
}
