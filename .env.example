# Kopyalayın: cp .env.example .env  (.env dosyası git'e girmez)
# Tüm PUBLIC_* değerleri tarayıcıya gider; buraya asla gizli anahtar yazmayın.

# Cloudflare Worker taban adresi (ör. https://api.keciorenisitme.com). Boşsa:
#  - randevu formu WhatsApp'a yönlendirir (sahte "gönderildi" gösterilmez)
#  - Google yorumları bölümü yalnızca Google bağlantı kartı gösterir
PUBLIC_API_BASE=

# Ölçüm (hepsi çerez onayı olmadan yüklenmez)
PUBLIC_GA4_ID=
PUBLIC_GADS_ID=
PUBLIC_GADS_APPOINTMENT_LABEL=
PUBLIC_META_PIXEL_ID=
PUBLIC_OPENAI_PIXEL_ID=

# Cloudflare Turnstile (site key; secret Worker tarafında)
PUBLIC_TURNSTILE_SITE_KEY=

# production yazılmadıkça sayfa noindex olur
PUBLIC_SITE_ENV=preview

# Yorum bölümü: 'carousel' (Google yorumları + puan) | 'link' (yalnızca Google profiline bağlantı).
# Boş bırakılırsa src/config/business.ts > reviewsDisplay geçerlidir. Hukuk notu: AYAZ-V2-RAPOR.md Tur 4.
PUBLIC_REVIEWS_DISPLAY=

# Hukuki metin kapısı (gizlilik/KVKK/çerez): PUBLIC_SITE_ENV=production derlemesi, src/config/business.ts >
# legalFacts içinde işletmenin doldurması gereken bilgi eksikse Türkçe listeyle DURUR.
# Metin onayı (textApproval) en son verilir: diğer bilgiler doluyken derleme, nihai metnin özetini içeren onay
# nesnesini basar; biri eksikken özet basılmaz (CONTENT-VERIFICATION.md §7).
# Yalnızca QA/deneme derlemesi için 1 yapılırsa derleme tamamlanır ve eksikler sayfada işaretli yer tutucu
# (<mark class="legal-todo">) olarak basılır. deploy.yml'de ASLA tanımlanmaz (tests/legal.test.ts deploy.yml'i
# denetler). GitHub Variables derlemeye kendiliğinden geçmez; yalnızca deploy.yml'in `vars.X` ile aktardıkları geçer,
# bu nedenle orada tanımlansa bile etkisizdir. Önizleme derlemelerinde gerekmez: yer tutucular zaten gösterilir.
# Bu bayrakla yapılan üretim derlemesinde tüm sayfalar noindex olur (QA derlemesi dizine eklenemez).
# Derleme sürecinin ortamından okunur; komut satırında verin:
#   PUBLIC_SITE_ENV=production ALLOW_INCOMPLETE_LEGAL=1 npx astro build --outDir /tmp/qa-build
# ALLOW_INCOMPLETE_LEGAL=1
